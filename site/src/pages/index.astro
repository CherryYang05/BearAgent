---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const target = `${base}zh-cn/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <title>BearAgent Docs</title>
  </head>
  <body>
    <p><a href={target}>进入 BearAgent 中文文档</a></p>
  </body>
</html>
